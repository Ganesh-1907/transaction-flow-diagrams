    linkStyle 9 stroke:#6a1b9a,stroke-width:3px
    linkStyle 12 stroke:transparent,stroke-width:0px
    linkStyle 15 stroke:#1565c0,stroke-width:3px
    linkStyle 19 stroke:#1565c0,stroke-width:3px
    linkStyle 24 stroke:#c62828,stroke-width:3px
    linkStyle 26 stroke:#e65100,stroke-width:3px
    linkStyle 31 stroke:#2e7d32,stroke-width:3px
    linkStyle 32 stroke:#6a1b9a,stroke-width:3px
    linkStyle 40 stroke:#2e7d32,stroke-width:3px
    linkStyle 41 stroke:#6a1b9a,stroke-width:3px

