    class rx_step1,free_thankyou,free_member_page,paid_step2,paid_step3,paid_close,paid_failed,paid_thankyou,paid_member_page,zero_thankyou,zero_member_page rxScreen;
    class free_users,paid_users userRow;
    class free_p1,free_p23,free_member_update,paid_p1,paid_p23,paid_p23_visible,paid_p1_paid,paid_member_update,zero_p1,zero_p23,zero_p1_conf,zero_member_update participantRow;
    class free_no_t txNone;
    class free_mail_primary,free_mail_member,paid_mail_retry,paid_mail_confirm,paid_mail_member,zero_mail_primary,zero_mail_member email;
