flowchart TD
    flow_start(("START"))
    rx_step1["Step 1 Personal info\n---\nname, email, mobile"]
    subgraph grp_users["users"]
        tbl_user[("INSERT or UPDATE user")]
    end
    rx_step2["Step 2 Registration details\n---\nfees, discount code, agreements\nchooses Pay Deposit (default is Pay Full Amount)\nshown only when deposits are enabled and still accepted"]
    tbl_p1[("INSERT P1\n---\nprogram_participant\ndeposit_type = DEPOSIT\ndeposit_amount = the deposit\ntotal_amount = full amount\nbalance_due = full amount (same as total_amount)\nNO transaction row yet")]
    subgraph grp_2_balance_pay_the_rest_later["2. BALANCE: pay the rest later"]
        bal_open["Participant opens the balance link\n---\nthank-you page Complete Payment button\nlink in the deposit email\nComplete Payment popup if the same email registers again"]
        bal_step3["Step 3 Payment: balance\n---\namount = balance_due\npurpose = REMAINING_AMOUNT\nevery Pay now click creates a new transaction"]
        bal_t_ok[("INSERT T, then UPDATE\n---\nprogram_participant_transaction\nPENDING -> CONFIRMED")]
        bal_p1_ok[("UPDATE P1\n---\nprogram_participant\nbalance_due = balance_due - amount paid (becomes 0)")]
        bal_mail_ok(["Confirmation email\n---\nbalance_due is 0 now"])
        bal_thankyou["Thank you page: payment successful\n---\nshows Amount Paid Now and Total Amount"]
        bal_t_fail[("INSERT T, then UPDATE\n---\nPENDING -> FAILED")]
        bal_no_mail(["NO failure email\n---\nbalance_due is not equal to total_amount\nparticipant uses Try again on the failed page"])
    end
    subgraph grp_1_deposit_pay_the_deposit_in_step_3["1. DEPOSIT: pay the deposit in step 3"]
        dep_step3["Step 3 Payment: deposit\n---\namount = deposit_amount\npurpose = DEPOSIT\nevery Pay now click creates a new transaction"]
        dep_t_ok[("INSERT T, then UPDATE\n---\nprogram_participant_transaction\nPENDING -> CONFIRMED\nP1 becomes visible (first transaction webhook)")]
        dep_p1_ok[("UPDATE P1\n---\nprogram_participant\nbalance_due = balance_due - deposit paid\npayment_status CONFIRMED (DB trigger)")]
        dep_mail_ok(["Deposit email\n---\nDEPOSIT_EMAIL\nhas the link to pay the balance"])
        dep_thankyou["Thank you page: deposit successful\n---\nshows Deposit Paid and Balance Amount\nComplete Payment button (balance_due > 0)"]
        dep_t_fail[("INSERT T, then UPDATE\n---\nPENDING -> FAILED")]
        dep_mail_fail(["Deposit failed email\n---\nDEPOSIT_FAILED\nsent whatever the balance\nhas the retry link"])
    end
    flow_start --> rx_step1
    rx_step1 -->|"Continue"| tbl_user
    tbl_user --> rx_step2
    rx_step2 -->|"Continue with Pay Deposit"| tbl_p1
    tbl_p1 -->|"<span style='color:rgb(21,101,192);font-weight:bold'>Payment step link</span>"| dep_step3
    dep_step3 -->|"click Pay now: payment succeeds"| dep_t_ok
    dep_t_ok --> dep_p1_ok
    dep_t_ok --> dep_mail_ok
    dep_t_ok -->|"<span style='color:rgb(46,125,50);font-weight:bold'>Thank you link</span>"| dep_thankyou
    dep_step3 -->|"click Pay now: payment declined"| dep_t_fail
    dep_t_fail --> dep_mail_fail
    dep_mail_fail -.->|"<span style='color:rgb(230,81,0);font-weight:bold'>Retry link</span><br/>Pay now again creates a new row"| dep_step3
    dep_thankyou -->|"<span style='color:rgb(21,101,192);font-weight:bold'>Payment step link</span><br/>Complete Payment button"| bal_open
    dep_mail_ok -->|"<span style='color:rgb(21,101,192);font-weight:bold'>Payment step link</span><br/>link in the email"| bal_open
    bal_open --> bal_step3
    bal_step3 -->|"click Pay now: payment succeeds"| bal_t_ok
    bal_t_ok --> bal_p1_ok
    bal_t_ok --> bal_mail_ok
    bal_t_ok -->|"<span style='color:rgb(46,125,50);font-weight:bold'>Thank you link</span>"| bal_thankyou
    bal_step3 -->|"click Pay now: payment declined"| bal_t_fail
    bal_t_fail --> bal_no_mail
    bal_t_fail -.->|"<span style='color:rgb(230,81,0);font-weight:bold'>Retry link</span><br/>Try again on the failed page"| bal_step3
    linkStyle 4 stroke:#1565c0,stroke-width:3px
    linkStyle 8 stroke:#2e7d32,stroke-width:3px
    linkStyle 11 stroke:#e65100,stroke-width:3px
    linkStyle 12 stroke:#1565c0,stroke-width:3px
    linkStyle 13 stroke:#1565c0,stroke-width:3px
    linkStyle 18 stroke:#2e7d32,stroke-width:3px
    linkStyle 21 stroke:#e65100,stroke-width:3px

