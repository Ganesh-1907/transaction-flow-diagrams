flowchart TD
    flow_start(("START"))
    rx_step1["Step 1 Personal info\n---\nname, email, mobile"]
    subgraph grp_users["users"]
        tbl_user[("INSERT or UPDATE user")]
    end
    rx_step2["Step 2 Registration details\n---\nfees, discount code, agreements"]
    subgraph grp_program_participant["program_participant"]
        tbl_participant[("INSERT P1\n---\npayment_status PENDING\nbalance_due = total_amount\nNO transaction row yet")]
        tbl_participant_paid[("UPDATE P1\n---\nbalance_due reduced by the amount paid\npayment_status CONFIRMED (DB trigger)")]
    end
    rx_step3["Step 3 Payment\n---\nevery Pay now click creates a new transaction\nalso opened again from the retry email link"]
    subgraph grp_program_participant_transaction["program_participant_transaction"]
        tbl_t1[("INSERT T1\n---\nP1 becomes visible (first transaction webhook)")]
        tbl_t1_failed[("UPDATE T1\n---\nPENDING -> FAILED")]
        tbl_t2[("INSERT T2, then UPDATE\n---\nPENDING -> FAILED")]
        tbl_t3[("INSERT T3, then UPDATE\n---\nPENDING -> CONFIRMED")]
    end
    rx_close["Case 1: user closes the tab\n---\nnothing else runs in rx"]
    rx_back["Case 2: user clicks Back\n---\nstep 3 reloads from the server\nT1 is PENDING (not final), so step 3 opens again"]
    caps_rescue[["CAPS rescue service\n---\nhourly job, T1 has no gateway id\nTupaggo: PENDING over 72h, other gateways: over 1h"]]
    rx_failed["Failed page\n---\npayment failed or any other status\nhas a Try again button"]
    mail_retry(["Retry payment email\n---\nsent when T1 or T2 turns FAILED\nbalance_due == total_amount (nothing paid yet)"])
    rx_thankyou["Thank you page\n---\npayment success or processing"]
    mail_confirm(["Confirmation email"])
    flow_start --> rx_step1
    rx_step1 -->|"Continue"| tbl_user
    tbl_user --> rx_step2
    rx_step2 -->|"Continue"| tbl_participant
    tbl_participant -->|"<span style='color:rgb(21,101,192);font-weight:bold'>Payment step link</span>"| rx_step3
    rx_step3 -->|"click 1: CAPS order, webhook created"| tbl_t1
    tbl_t1 -->|"card / PIN not finished"| rx_close
    tbl_t1 -->|"card / PIN not finished"| rx_back
    rx_back -.->|"step 3 opens again"| rx_step3
    tbl_t1 -.->|"stays PENDING"| caps_rescue
    caps_rescue -->|"webhook failed"| tbl_t1_failed
    tbl_t1_failed --> mail_retry
    rx_step3 -->|"click 2: payment declined"| tbl_t2
    tbl_t2 --> mail_retry
    tbl_t2 -->|"<span style='color:rgb(198,40,40);font-weight:bold'>Fail link</span>"| rx_failed
    rx_failed -.->|"<span style='color:rgb(230,81,0);font-weight:bold'>Retry link</span><br/>Try again button"| rx_step3
    mail_retry -.->|"<span style='color:rgb(230,81,0);font-weight:bold'>Retry link</span><br/>participant clicks it, step 3 opens again"| rx_step3
    rx_step3 -->|"click 3: payment succeeds"| tbl_t3
    tbl_t3 -->|"balance_due reduced"| tbl_participant_paid
    tbl_t3 --> mail_confirm
    tbl_t3 -->|"<span style='color:rgb(46,125,50);font-weight:bold'>Thank you link</span>"| rx_thankyou
    linkStyle 4 stroke:#1565c0,stroke-width:3px
    linkStyle 14 stroke:#c62828,stroke-width:3px
    linkStyle 15 stroke:#e65100,stroke-width:3px
    linkStyle 16 stroke:#e65100,stroke-width:3px
    linkStyle 20 stroke:#2e7d32,stroke-width:3px

    classDef rxScreen fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px;
    classDef bxScreen fill:#e0f7fa,stroke:#006064,stroke-width:2px;
    classDef bxService fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px;
    classDef capsService fill:#eceff1,stroke:#37474f,stroke-width:2px;
    classDef userRow fill:#ede7f6,stroke:#4527a0,stroke-width:2px;
    classDef participantRow fill:#e3f2fd,stroke:#0d47a1,stroke-width:2px;
    classDef txPending fill:#fff59d,stroke:#f9a825,stroke-width:2px;
    classDef txProcessing fill:#b3e5fc,stroke:#0277bd,stroke-width:2px;
    classDef txConfirmed fill:#a5d6a7,stroke:#2e7d32,stroke-width:2px;
    classDef txFailed fill:#ef9a9a,stroke:#c62828,stroke-width:2px;
    classDef txNotReceived fill:#ffccbc,stroke:#bf360c,stroke-width:2px;
    classDef txNone fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px;
    classDef email fill:#ffe0b2,stroke:#e65100,stroke-width:2px;
    classDef startNode fill:#2e7d32,stroke:#1b5e20,stroke-width:3px,color:#fff;
    classDef problem fill:#ffebee,stroke:#c62828,stroke-width:3px,stroke-dasharray:6 3;
    classDef expected fill:#c8e6c9,stroke:#2e7d32,stroke-width:3px;
    class flow_start startNode;
    class rx_step1,rx_step2,rx_step3,rx_close,rx_back,rx_failed,rx_thankyou rxScreen;
    class tbl_user userRow;
    class tbl_participant,tbl_participant_paid participantRow;
    class tbl_t1 txPending;
    class caps_rescue capsService;
    class tbl_t1_failed,tbl_t2 txFailed;
    class mail_retry,mail_confirm email;
    class tbl_t3 txConfirmed;
    style grp_users fill:#fafcff,stroke:#78909c,stroke-dasharray:4 3;
    style grp_program_participant fill:#fafcff,stroke:#78909c,stroke-dasharray:4 3;
    style grp_program_participant_transaction fill:#fafcff,stroke:#78909c,stroke-dasharray:4 3;